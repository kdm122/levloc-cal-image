+// @vitest-environment node
+import { beforeEach, describe, expect, it } from "vitest";
+
+import { consumeToken, resetRateLimiterForTests } from "./inMemoryRateLimiter";
+import { LruCache } from "./lruCache";
+
+describe("consumeToken", () => {
+  beforeEach(() => resetRateLimiterForTests());
+
+  it("allows up to capacity, then rejects with a retry hint", () => {
+    const opts = { capacity: 3, refillPerSec: 1 };
+    const now = 1_000_000;
+    expect(consumeToken("k", opts, now).ok).toBe(true);
+    expect(consumeToken("k", opts, now).ok).toBe(true);
+    expect(consumeToken("k", opts, now).ok).toBe(true);
+    const rejected = consumeToken("k", opts, now);
+    expect(rejected.ok).toBe(false);
+    expect(rejected.retryAfterSec).toBe(1);
+  });
+
+  it("refills over time", () => {
+    const opts = { capacity: 1, refillPerSec: 0.5 };
+    expect(consumeToken("k", opts, 0).ok).toBe(true);
+    expect(consumeToken("k", opts, 1000).ok).toBe(false);
+    expect(consumeToken("k", opts, 3000).ok).toBe(true);
+  });
+
+  it("tracks keys independently", () => {
+    const opts = { capacity: 1, refillPerSec: 0.01 };
+    expect(consumeToken("a", opts, 0).ok).toBe(true);
+    expect(consumeToken("a", opts, 0).ok).toBe(false);
+    expect(consumeToken("b", opts, 0).ok).toBe(true);
+  });
+});
+
+describe("LruCache", () => {
+  it("expires entries after the TTL", () => {
+    const cache = new LruCache<string>(10, 1000);
+    cache.set("a", "1", 0);
+    expect(cache.get("a", 999)).toBe("1");
+    expect(cache.get("a", 1000)).toBeUndefined();
+  });
+
+  it("evicts the least recently used entry", () => {
+    const cache = new LruCache<string>(2, 60_000);
+    cache.set("a", "1", 0);
+    cache.set("b", "2", 0);
+    cache.get("a", 1); // a is now most recent
+    cache.set("c", "3", 2);
+    expect(cache.get("b", 3)).toBeUndefined();
+    expect(cache.get("a", 3)).toBe("1");
+    expect(cache.get("c", 3)).toBe("3");
+    expect(cache.size).toBe(2);
+  });
+
+  it("can cache null as a value", () => {
+    const cache = new LruCache<string | null>(2, 60_000);
+    cache.set("missing", null, 0);
+    expect(cache.get("missing", 1)).toBeNull();
+  });
+});
