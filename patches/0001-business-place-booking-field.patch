+import { describe, expect, it } from "vitest";
+
+import {
+  buildBusinessPlaceSummary,
+  formatBusinessPlaceText,
+  getBusinessPlaceLines,
+  isBusinessPlaceValue,
+  normalizeBusinessPlace,
+} from "./businessPlace";
+
+const PLACE_ID = "ChIJN1t_tDeuEmsRUsoyG83frY4";
+
+describe("isBusinessPlaceValue", () => {
+  it("accepts a structured value", () => {
+    expect(isBusinessPlaceValue({ value: "Acme — 1 Main St", name: "Acme", placeId: PLACE_ID })).toBe(true);
+    expect(isBusinessPlaceValue({ value: "Acme", name: "Acme" })).toBe(true);
+  });
+
+  it("rejects the radioInput/location shape", () => {
+    expect(isBusinessPlaceValue({ value: "Acme", optionValue: "x", name: "Acme" })).toBe(false);
+  });
+
+  it("rejects the name field shape", () => {
+    expect(isBusinessPlaceValue({ firstName: "Jane", lastName: "Doe" })).toBe(false);
+  });
+
+  it("rejects primitives, arrays and null", () => {
+    expect(isBusinessPlaceValue("Acme")).toBe(false);
+    expect(isBusinessPlaceValue(["Acme"])).toBe(false);
+    expect(isBusinessPlaceValue(null)).toBe(false);
+    expect(isBusinessPlaceValue(undefined)).toBe(false);
+  });
+
+  it("rejects known keys holding non-strings", () => {
+    expect(isBusinessPlaceValue({ value: "Acme", name: "Acme", phone: 5551234 })).toBe(false);
+  });
+});
+
+describe("buildBusinessPlaceSummary", () => {
+  it("joins name and address", () => {
+    expect(buildBusinessPlaceSummary("Acme", "1 Main St")).toBe("Acme — 1 Main St");
+  });
+
+  it("returns just the name without an address", () => {
+    expect(buildBusinessPlaceSummary(" Acme ")).toBe("Acme");
+    expect(buildBusinessPlaceSummary("Acme", "  ")).toBe("Acme");
+  });
+});
+
+describe("normalizeBusinessPlace", () => {
+  it("keeps known keys, trims them and strips unknown and empty keys", () => {
+    expect(
+      normalizeBusinessPlace({
+        value: " Acme — 1 Main St ",
+        name: " Acme ",
+        placeId: PLACE_ID,
+        address: "1 Main St",
+        phone: "+1 555-123-4567",
+        category: "  ",
+        rating: "4.8",
+        nested: { evil: true },
+      })
+    ).toEqual({
+      value: "Acme — 1 Main St",
+      name: "Acme",
+      placeId: PLACE_ID,
+      address: "1 Main St",
+      phone: "+1 555-123-4567",
+    });
+  });
+
+  it("returns an empty string when there is no usable name", () => {
+    expect(normalizeBusinessPlace({})).toBe("");
+    expect(normalizeBusinessPlace({ value: "   " })).toBe("");
+    expect(normalizeBusinessPlace({ address: "1 Main St" })).toBe("");
+    expect(normalizeBusinessPlace("Acme")).toBe("");
+    expect(normalizeBusinessPlace(null)).toBe("");
+    expect(normalizeBusinessPlace(["Acme"])).toBe("");
+  });
+
+  it("fills the name from the value", () => {
+    expect(normalizeBusinessPlace({ value: "Acme" })).toEqual({ value: "Acme", name: "Acme" });
+  });
+
+  it("builds the value summary from name and address", () => {
+    expect(normalizeBusinessPlace({ name: "Acme", address: "1 Main St" })).toEqual({
+      value: "Acme — 1 Main St",
+      name: "Acme",
+      address: "1 Main St",
+    });
+  });
+
+  it("prefixes bare-domain websites with https", () => {
+    expect(normalizeBusinessPlace({ name: "Acme", website: "acme.com" })).toMatchObject({
+      website: "https://acme.com",
+    });
+    expect(normalizeBusinessPlace({ name: "Acme", website: "www.acme.com/contact" })).toMatchObject({
+      website: "https://www.acme.com/contact",
+    });
+  });
+
+  it("keeps http(s) websites", () => {
+    expect(normalizeBusinessPlace({ name: "Acme", website: "http://acme.com/" })).toMatchObject({
+      website: "http://acme.com/",
+    });
+  });
+
+  it("drops unsafe or invalid websites", () => {
+    for (const website of ["javascript:alert(1)", "data:text/html,hi", "ftp://acme.com", "not a url", "acme"]) {
+      expect(normalizeBusinessPlace({ name: "Acme", website })).toEqual({ value: "Acme", name: "Acme" });
+    }
+  });
+
+  it("keeps only https Google Maps links", () => {
+    expect(
+      normalizeBusinessPlace({ name: "Acme", mapsUrl: "https://maps.google.com/?cid=123" })
+    ).toMatchObject({ mapsUrl: "https://maps.google.com/?cid=123" });
+    expect(normalizeBusinessPlace({ name: "Acme", mapsUrl: "https://www.google.co.uk/maps/x" })).toMatchObject({
+      mapsUrl: "https://www.google.co.uk/maps/x",
+    });
+    for (const mapsUrl of [
+      "https://evil.com/?cid=123",
+      "https://google.evil.com/maps",
+      "https://notgoogle.com/maps",
+      "http://maps.google.com/?cid=123",
+      "javascript:alert(1)",
+    ]) {
+      expect(normalizeBusinessPlace({ name: "Acme", mapsUrl })).toEqual({ value: "Acme", name: "Acme" });
+    }
+  });
+
+  it("truncates long text fields", () => {
+    const result = normalizeBusinessPlace({ name: "A".repeat(250), address: "B".repeat(400) });
+    expect(result).not.toBe("");
+    if (!result) return;
+    expect(result.name).toHaveLength(200);
+    expect(result.address).toHaveLength(300);
+    expect(result.value.length).toBeLessThanOrEqual(500);
+  });
+
+  it("drops an overlong phone number instead of truncating it", () => {
+    expect(normalizeBusinessPlace({ name: "Acme", phone: "1".repeat(41) })).toEqual({
+      value: "Acme",
+      name: "Acme",
+    });
+  });
+
+  it("does not truncate the place id", () => {
+    const longId = "a".repeat(600);
+    expect(normalizeBusinessPlace({ name: "Acme", placeId: longId })).toMatchObject({ placeId: longId });
+  });
+});
+
+describe("formatBusinessPlaceText", () => {
+  const full = {
+    value: "Acme — 1 Main St",
+    name: "Acme",
+    placeId: PLACE_ID,
+    address: "1 Main St",
+    phone: "+1 555-123-4567",
+    website: "https://acme.com",
+    mapsUrl: "https://maps.google.com/?cid=1",
+    category: "Plumber",
+  };
+
+  it("formats a single line", () => {
+    expect(formatBusinessPlaceText(full)).toBe("Acme, 1 Main St, +1 555-123-4567, https://acme.com");
+  });
+
+  it("formats multiple lines with category and maps link", () => {
+    expect(formatBusinessPlaceText(full, { multiline: true })).toBe(
+      ["Acme", "1 Main St", "Plumber", "+1 555-123-4567", "https://acme.com", "https://maps.google.com/?cid=1"].join(
+        "\n"
+      )
+    );
+  });
+
+  it("returns just the name for free text", () => {
+    expect(formatBusinessPlaceText({ value: "Acme", name: "Acme" }, { multiline: true })).toBe("Acme");
+  });
+});
+
+describe("getBusinessPlaceLines", () => {
+  it("returns lines with safe hrefs", () => {
+    expect(
+      getBusinessPlaceLines({
+        value: "Acme — 1 Main St",
+        name: "Acme",
+        address: "1 Main St",
+        category: "Plumber",
+        phone: "+1 (555) 123-4567",
+        website: "https://acme.com/",
+        mapsUrl: "https://maps.google.com/?cid=1",
+      })
+    ).toEqual([
+      { kind: "name", text: "Acme" },
+      { kind: "address", text: "1 Main St" },
+      { kind: "category", text: "Plumber" },
+      { kind: "phone", text: "+1 (555) 123-4567", href: "tel:+15551234567" },
+      { kind: "website", text: "acme.com", href: "https://acme.com/" },
+      { kind: "maps", text: "Google Maps", href: "https://maps.google.com/?cid=1" },
+    ]);
+  });
+
+  it("never yields an href for a tampered link", () => {
+    const lines = getBusinessPlaceLines({
+      value: "Acme",
+      name: "Acme",
+      website: "javascript:alert(1)",
+      mapsUrl: "https://evil.com",
+    });
+    expect(lines).toEqual([{ kind: "name", text: "Acme" }]);
+  });
+});
