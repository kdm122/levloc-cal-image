+import { z } from "zod";
+
+import { BUSINESS_PLACE_ID_REGEX } from "@calcom/lib/bookings/businessPlace";
+import { checkRateLimitAndThrowError } from "@calcom/lib/checkRateLimitAndThrowError";
+
+import {
+  autocompletePlaces,
+  getPlaceDetails,
+  isPlacesEnabled,
+  type PlaceDetails,
+  type PlaceSuggestion,
+} from "./googlePlacesClient";
+import { consumeToken } from "./inMemoryRateLimiter";
+import { LruCache } from "./lruCache";
+
+/**
+ * Framework-free handlers behind `/api/places/*`. The route files only translate these results into
+ * `NextResponse`s, which keeps everything here unit-testable.
+ */
+export type PlacesHandlerResult = {
+  status: number;
+  body: unknown;
+  headers: Record<string, string>;
+};
+
+const NO_STORE = { "Cache-Control": "no-store" };
+
+const AUTOCOMPLETE_BUCKET = { capacity: 30, refillPerSec: 0.5 };
+const DETAILS_BUCKET = { capacity: 10, refillPerSec: 10 / 60 };
+
+const autocompleteCache = new LruCache<PlaceSuggestion[]>(500, 5 * 60 * 1000);
+const detailsCache = new LruCache<PlaceDetails | null>(500, 10 * 60 * 1000);
+
+const sessionTokenSchema = z.string().uuid().optional();
+
+const autocompleteQuerySchema = z.object({
+  input: z.string().trim().min(3).max(120),
+  sessionToken: sessionTokenSchema,
+  lang: z
+    .string()
+    .max(10)
+    .regex(/^[A-Za-z]{2,3}([_-][A-Za-z0-9]{2,8})*$/)
+    .optional(),
+});
+
+const detailsQuerySchema = z.object({
+  placeId: z.string().regex(BUSINESS_PLACE_ID_REGEX),
+  sessionToken: sessionTokenSchema,
+});
+
+const disabledResult = (): PlacesHandlerResult => ({
+  status: 503,
+  headers: NO_STORE,
+  body: { enabled: false },
+});
+
+const rateLimitedResult = (retryAfterSec: number): PlacesHandlerResult => ({
+  status: 429,
+  headers: { ...NO_STORE, "Retry-After": String(retryAfterSec) },
+  body: { message: "rate_limited" },
+});
+
+const validationErrorResult = (error: z.ZodError): PlacesHandlerResult => ({
+  status: 400,
+  headers: NO_STORE,
+  body: {
+    message: "VALIDATION_ERROR",
+    errors: error.errors.map((err) => ({
+      path: err.path.join("."),
+      errorCode: `error.validation.${err.code}`,
+    })),
+  },
+});
+
+const optionalParam = (searchParams: URLSearchParams, key: string) => searchParams.get(key) || undefined;
+
+export async function handleAutocompleteRequest({
+  searchParams,
+  clientKey,
+}: {
+  searchParams: URLSearchParams;
+  clientKey: string;
+}): Promise<PlacesHandlerResult> {
+  if (!isPlacesEnabled()) return disabledResult();
+
+  // No-op unless UNKEY_ROOT_KEY is configured; the in-memory bucket below is what actually applies here.
+  await checkRateLimitAndThrowError({ rateLimitingType: "common", identifier: `api:places-ac:${clientKey}` });
+  const bucket = consumeToken(`ac:${clientKey}`, AUTOCOMPLETE_BUCKET);
+  if (!bucket.ok) return rateLimitedResult(bucket.retryAfterSec);
+
+  const parsed = autocompleteQuerySchema.safeParse({
+    input: searchParams.get("input") ?? undefined,
+    sessionToken: optionalParam(searchParams, "sessionToken"),
+    lang: optionalParam(searchParams, "lang"),
+  });
+  if (!parsed.success) return validationErrorResult(parsed.error);
+
+  const { input, sessionToken, lang } = parsed.data;
+  const languageCode = lang?.replace("_", "-");
+  const cacheKey = `${(languageCode ?? "").toLowerCase()}|${input.toLowerCase().replace(/\s+/g, " ")}`;
+
+  let suggestions = autocompleteCache.get(cacheKey);
+  if (!suggestions) {
+    suggestions = await autocompletePlaces({ input, sessionToken, languageCode });
+    autocompleteCache.set(cacheKey, suggestions);
+  }
+
+  return { status: 200, headers: NO_STORE, body: { enabled: true, suggestions } };
+}
+
+export async function handleDetailsRequest({
+  placeId,
+  searchParams,
+  clientKey,
+}: {
+  placeId: unknown;
+  searchParams: URLSearchParams;
+  clientKey: string;
+}): Promise<PlacesHandlerResult> {
+  if (!isPlacesEnabled()) return disabledResult();
+
+  await checkRateLimitAndThrowError({
+    rateLimitingType: "common",
+    identifier: `api:places-details:${clientKey}`,
+  });
+  const bucket = consumeToken(`det:${clientKey}`, DETAILS_BUCKET);
+  if (!bucket.ok) return rateLimitedResult(bucket.retryAfterSec);
+
+  const parsed = detailsQuerySchema.safeParse({
+    placeId,
+    sessionToken: optionalParam(searchParams, "sessionToken"),
+  });
+  if (!parsed.success) return validationErrorResult(parsed.error);
+
+  let place = detailsCache.get(parsed.data.placeId);
+  if (place === undefined) {
+    place = await getPlaceDetails({ placeId: parsed.data.placeId, sessionToken: parsed.data.sessionToken });
+    detailsCache.set(parsed.data.placeId, place);
+  }
+
+  if (!place) return { status: 404, headers: NO_STORE, body: { enabled: true, place: null } };
+  return { status: 200, headers: NO_STORE, body: { enabled: true, place } };
+}
+
+export function resetPlacesCachesForTests() {
+  autocompleteCache.clear();
+  detailsCache.clear();
+}
