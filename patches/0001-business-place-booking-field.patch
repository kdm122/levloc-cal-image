@@ -0,0 +1,197 @@
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { useState } from "react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import type { BusinessPlaceValue } from "@calcom/lib/bookings/businessPlace";
+
+import { BusinessPlaceInput } from "./BusinessPlaceInput";
+
+vi.mock("@calcom/lib/hooks/useLocale", () => ({
+  useLocale: () => ({
+    t: (key: string, opts?: { text?: string }) => (opts?.text ? `${key}:${opts.text}` : key),
+    i18n: { language: "en" },
+  }),
+}));
+
+const PLACE_ID = "ChIJN1t_tDeuEmsRUsoyG83frY4";
+const UUID_REGEX = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+const jsonResponse = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { "Content-Type": "application/json" } });
+
+const autocompleteBody = {
+  enabled: true,
+  suggestions: [{ placeId: PLACE_ID, mainText: "Acme Plumbing", secondaryText: "1 Main St, Austin, TX" }],
+};
+
+const detailsBody = {
+  enabled: true,
+  place: {
+    placeId: PLACE_ID,
+    name: "Acme Plumbing",
+    address: "1 Main St, Austin, TX 78701, USA",
+    phone: "+1 512-555-0100",
+    website: "https://acme.example/",
+    mapsUrl: "https://maps.google.com/?cid=1",
+    category: "Plumber",
+  },
+};
+
+let fetchMock: ReturnType<typeof vi.fn>;
+
+function Harness({
+  initialValue,
+  onSetValue,
+  readOnly,
+}: {
+  initialValue?: BusinessPlaceValue | string;
+  onSetValue: (value: BusinessPlaceValue | "") => void;
+  readOnly?: boolean;
+}) {
+  const [value, setValue] = useState<BusinessPlaceValue | string | undefined>(initialValue);
+  return (
+    <BusinessPlaceInput
+      id="business"
+      name="business"
+      placeholder="Search business"
+      value={value}
+      readOnly={readOnly}
+      setValue={(next) => {
+        onSetValue(next);
+        setValue(next);
+      }}
+    />
+  );
+}
+
+const getSearchInput = (container: HTMLElement) => container.querySelector("#business") as HTMLInputElement;
+
+const typeInto = (input: HTMLInputElement, text: string) => {
+  fireEvent.focus(input);
+  fireEvent.change(input, { target: { value: text } });
+};
+
+const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+beforeEach(() => {
+  fetchMock = vi.fn();
+  vi.stubGlobal("fetch", fetchMock);
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+describe("BusinessPlaceInput", () => {
+  it("does not search with fewer than 3 characters", async () => {
+    const onSetValue = vi.fn();
+    const { container } = render(<Harness onSetValue={onSetValue} />);
+    typeInto(getSearchInput(container), "ac");
+    await sleep(450);
+    expect(fetchMock).not.toHaveBeenCalled();
+  });
+
+  it("searches after the debounce with a uuid session token", async () => {
+    fetchMock.mockResolvedValue(jsonResponse(autocompleteBody));
+    const { container } = render(<Harness onSetValue={vi.fn()} />);
+    typeInto(getSearchInput(container), "acme");
+
+    await waitFor(() => expect(fetchMock).toHaveBeenCalledTimes(1));
+    const url = new URL(fetchMock.mock.calls[0][0] as string, "http://localhost");
+    expect(url.pathname).toBe("/api/places/autocomplete");
+    expect(url.searchParams.get("input")).toBe("acme");
+    expect(url.searchParams.get("sessionToken")).toMatch(UUID_REGEX);
+  });
+
+  it("stores the structured business when a suggestion is chosen", async () => {
+    fetchMock.mockImplementation(async (input: string) =>
+      input.includes("/api/places/details/") ? jsonResponse(detailsBody) : jsonResponse(autocompleteBody)
+    );
+    const onSetValue = vi.fn();
+    const { container } = render(<Harness onSetValue={onSetValue} />);
+    typeInto(getSearchInput(container), "acme");
+
+    const option = await screen.findByText("Acme Plumbing");
+    fireEvent.click(option);
+
+    // Optimistic value from the prediction...
+    expect(onSetValue).toHaveBeenCalledWith({
+      value: "Acme Plumbing — 1 Main St, Austin, TX",
+      name: "Acme Plumbing",
+      address: "1 Main St, Austin, TX",
+      placeId: PLACE_ID,
+    });
+
+    // ...then enriched with Place Details, reusing the autocomplete session token.
+    await waitFor(() =>
+      expect(onSetValue).toHaveBeenLastCalledWith({
+        value: "Acme Plumbing — 1 Main St, Austin, TX 78701, USA",
+        name: "Acme Plumbing",
+        placeId: PLACE_ID,
+        address: "1 Main St, Austin, TX 78701, USA",
+        phone: "+1 512-555-0100",
+        website: "https://acme.example/",
+        mapsUrl: "https://maps.google.com/?cid=1",
+        category: "Plumber",
+      })
+    );
+    const autocompleteUrl = new URL(fetchMock.mock.calls[0][0] as string, "http://localhost");
+    const detailsUrl = new URL(fetchMock.mock.calls[1][0] as string, "http://localhost");
+    expect(detailsUrl.pathname).toBe(`/api/places/details/${PLACE_ID}`);
+    expect(detailsUrl.searchParams.get("sessionToken")).toBe(autocompleteUrl.searchParams.get("sessionToken"));
+  });
+
+  it("stores free text when 'use as entered' is chosen", async () => {
+    fetchMock.mockResolvedValue(jsonResponse({ enabled: true, suggestions: [] }));
+    const onSetValue = vi.fn();
+    const { container } = render(<Harness onSetValue={onSetValue} />);
+    typeInto(getSearchInput(container), "Corner Bakery");
+
+    fireEvent.click(await screen.findByText("use_as_entered:Corner Bakery"));
+    expect(onSetValue).toHaveBeenCalledWith({ value: "Corner Bakery", name: "Corner Bakery" });
+  });
+
+  it("switches to a plain text input when the API is disabled", async () => {
+    fetchMock.mockResolvedValue(jsonResponse({ enabled: false }, 503));
+    const onSetValue = vi.fn();
+    const { container } = render(<Harness onSetValue={onSetValue} />);
+    typeInto(getSearchInput(container), "acme");
+
+    const fallbackInput = (await screen.findByPlaceholderText("Search business")) as HTMLInputElement;
+    // What was already typed is kept and committed as free text
+    expect(fallbackInput.value).toBe("acme");
+    expect(onSetValue).toHaveBeenCalledWith({ value: "acme", name: "acme" });
+
+    fireEvent.change(fallbackInput, { target: { value: "Acme Co " } });
+    expect(onSetValue).toHaveBeenLastCalledWith({ value: "Acme Co", name: "Acme Co" });
+
+    fireEvent.change(fallbackInput, { target: { value: "" } });
+    expect(onSetValue).toHaveBeenLastCalledWith("");
+  });
+
+  it("shows an existing value and clears it", async () => {
+    const onSetValue = vi.fn();
+    const { container } = render(
+      <Harness
+        initialValue={{ value: "Acme Plumbing — 1 Main St", name: "Acme Plumbing", placeId: PLACE_ID }}
+        onSetValue={onSetValue}
+      />
+    );
+    expect(screen.getByText("Acme Plumbing — 1 Main St")).toBeInTheDocument();
+
+    const input = getSearchInput(container);
+    fireEvent.focus(input);
+    fireEvent.keyDown(input, { key: "Backspace", code: "Backspace", keyCode: 8 });
+    expect(onSetValue).toHaveBeenLastCalledWith("");
+  });
+
+  it("hydrates a legacy plain string value", () => {
+    render(<Harness initialValue="Corner Bakery" onSetValue={vi.fn()} />);
+    expect(screen.getByText("Corner Bakery")).toBeInTheDocument();
+  });
+
+  it("is disabled when read only", () => {
+    const { container } = render(<Harness onSetValue={vi.fn()} readOnly />);
+    expect(getSearchInput(container)).toBeDisabled();
+  });
+});
diff --git a/apps/web/modules/form-builder/components/BusinessPlaceInput.tsx b/apps/web/modules/form-builder/components/BusinessPlaceInput.tsx
new file mode 100644
index 0000000..c3ed133
--- /dev/null
+++ b/apps/web/modules/form-builder/components/BusinessPlaceInput.tsx
@@ -0,0 +1,331 @@
+import { useEffect, useMemo, useRef, useState } from "react";
+import type { FormatOptionLabelMeta, InputActionMeta, SingleValue } from "react-select";
+
+import {
+  type BusinessPlaceValue,
+  buildBusinessPlaceSummary,
+  isBusinessPlaceValue,
+  normalizeBusinessPlace,
+} from "@calcom/lib/bookings/businessPlace";
+import { useDebounce } from "@calcom/lib/hooks/useDebounce";
+import { useLocale } from "@calcom/lib/hooks/useLocale";
+import { Input, Select } from "@calcom/ui/components/form";
+import { Icon } from "@calcom/ui/components/icon";
+
+export type BusinessPlaceInputProps = {
+  id?: string;
+  name?: string;
+  value: BusinessPlaceValue | string | undefined;
+  setValue: (value: BusinessPlaceValue | "") => void;
+  placeholder?: string;
+  readOnly?: boolean;
+  disabled?: boolean;
+};
+
+type Suggestion = { placeId: string; mainText: string; secondaryText: string };
+
+type Option =
+  | { kind: "prediction"; value: string; label: string; suggestion: Suggestion }
+  | { kind: "freeText"; value: string; label: string; text: string }
+  | { kind: "selected"; value: string; label: string };
+
+const MIN_QUERY_LENGTH = 3;
+const DEBOUNCE_MS = 300;
+
+export function newPlacesSessionToken(): string {
+  const cryptoObj = (globalThis as { crypto?: Crypto }).crypto;
+  if (cryptoObj && typeof cryptoObj.randomUUID === "function") {
+    return cryptoObj.randomUUID();
+  }
+  return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, (char) => {
+    const random = (Math.random() * 16) | 0;
+    const nibble = char === "x" ? random : (random & 0x3) | 0x8;
+    return nibble.toString(16);
+  });
+}
+
+function toSelected(value: BusinessPlaceInputProps["value"]): BusinessPlaceValue | null {
+  if (isBusinessPlaceValue(value)) return value;
+  if (typeof value === "string" && value.trim()) return { value: value.trim(), name: value.trim() };
+  return null;
+}
+
+function freeTextValue(text: string): BusinessPlaceValue | "" {
+  return normalizeBusinessPlace({ value: text, name: text });
+}
+
+/**
+ * Booker input for the `businessPlace` booking question. Searches Google Places (via our own
+ * `/api/places/*` proxy) and stores the chosen listing as a structured object. Falls back to a plain
+ * text input when the proxy is disabled or unreachable.
+ */
+export function BusinessPlaceInput({
+  id,
+  name,
+  value,
+  setValue,
+  placeholder,
+  readOnly,
+  disabled,
+}: BusinessPlaceInputProps) {
+  const { t, i18n } = useLocale();
+  const selected = toSelected(value);
+
+  const [inputValue, setInputValue] = useState("");
+  const debouncedInput = useDebounce(inputValue, DEBOUNCE_MS);
+  const [suggestions, setSuggestions] = useState<Suggestion[]>([]);
+  const [isLoading, setIsLoading] = useState(false);
+  const [fallback, setFallback] = useState(false);
+  const [fallbackText, setFallbackText] = useState(selected?.value ?? "");
+  const [focusFallback, setFocusFallback] = useState(false);
+
+  const selectedRef = useRef(selected);
+  selectedRef.current = selected;
+  const setValueRef = useRef(setValue);
+  setValueRef.current = setValue;
+  const inputValueRef = useRef("");
+  const sessionTokenRef = useRef<string>(newPlacesSessionToken());
+  const hasSucceededRef = useRef(false);
+  const latestPlaceIdRef = useRef<string | null>(null);
+  const mountedRef = useRef(true);
+
+  useEffect(() => {
+    mountedRef.current = true;
+    return () => {
+      mountedRef.current = false;
+    };
+  }, []);
+
+  const updateInput = (next: string) => {
+    inputValueRef.current = next;
+    setInputValue(next);
+  };
+
+  // Switch to the plain text input without losing what the booker already typed.
+  const enterFallback = () => {
+    const typed = inputValueRef.current;
+    setFallbackText(typed || selectedRef.current?.value || "");
+    if (typed.trim() && !selectedRef.current) {
+      setValueRef.current(freeTextValue(typed));
+    }
+    setFocusFallback(!!typed);
+    setFallback(true);
+  };
+
+  useEffect(() => {
+    if (fallback) return;
+    const query = debouncedInput.trim();
+    if (query.length < MIN_QUERY_LENGTH) {
+      setSuggestions([]);
+      setIsLoading(false);
+      return;
+    }
+
+    const controller = new AbortController();
+    const params = new URLSearchParams({ input: query, sessionToken: sessionTokenRef.current });
+    const language = i18n?.language;
+    if (language) params.set("lang", language.slice(0, 10));
+
+    setIsLoading(true);
+    fetch(`/api/places/autocomplete?${params.toString()}`, { signal: controller.signal })
+      .then(async (res) => {
+        if (res.status === 503) {
+          enterFallback();
+          return;
+        }
+        if (!res.ok) {
+          setSuggestions([]);
+          return;
+        }
+        const data = await res.json();
+        if (data?.enabled === false) {
+          enterFallback();
+          return;
+        }
+        hasSucceededRef.current = true;
+        setSuggestions(Array.isArray(data?.suggestions) ? data.suggestions : []);
+      })
+      .catch((error: unknown) => {
+        if ((error as { name?: string })?.name === "AbortError") return;
+        // Only give up on search if it never worked; later network blips just show no suggestions.
+        if (!hasSucceededRef.current) {
+          enterFallback();
+        } else {
+          setSuggestions([]);
+        }
+      })
+      .finally(() => {
+        if (!controller.signal.aborted) setIsLoading(false);
+      });
+
+    return () => controller.abort();
+  }, [debouncedInput, fallback, i18n?.language]);
+
+  const fetchDetails = (suggestion: Suggestion, sessionToken: string) => {
+    const params = new URLSearchParams({ sessionToken });
+    fetch(`/api/places/details/${encodeURIComponent(suggestion.placeId)}?${params.toString()}`)
+      .then((res) => (res.ok ? res.json() : null))
+      .then((data) => {
+        const place = data?.place;
+        if (!place || !mountedRef.current) return;
+        // The booker may have picked something else while details were loading.
+        if (latestPlaceIdRef.current !== suggestion.placeId) return;
+        const placeName = typeof place.name === "string" && place.name ? place.name : suggestion.mainText;
+        const address =
+          typeof place.address === "string" && place.address ? place.address : suggestion.secondaryText;
+        const full = normalizeBusinessPlace({
+          ...place,
+          placeId: suggestion.placeId,
+          name: placeName,
+          address,
+          value: buildBusinessPlaceSummary(placeName, address),
+        });
+        if (full) setValue(full);
+      })
+      .catch(() => {
+        // Keep the optimistic value from the prediction.
+      });
+  };
+
+  const options = useMemo<Option[]>(() => {
+    const predictionOptions: Option[] = suggestions.map((suggestion) => ({
+      kind: "prediction",
+      value: suggestion.placeId,
+      label: suggestion.mainText,
+      suggestion,
+    }));
+    const typed = inputValue.trim();
+    if (typed) {
+      predictionOptions.push({
+        kind: "freeText",
+        value: `__free_text__:${typed}`,
+        // React escapes the text; i18next escaping would show "&amp;" for "Smith & Sons".
+        label: t("use_as_entered", { text: typed, interpolation: { escapeValue: false } }),
+        text: typed,
+      });
+    }
+    return predictionOptions;
+  }, [suggestions, inputValue, t]);
+
+  const isDisabled = !!(readOnly || disabled);
+
+  if (fallback) {
+    return (
+      <div className="relative flex items-center">
+        <Icon
+          name="building"
+          className="text-muted absolute left-0.5 ml-3 h-4 w-4 -translate-y-1/2"
+          style={{ top: "44%" }}
+        />
+        <Input
+          id={id}
+          name={name}
+          placeholder={placeholder}
+          disabled={isDisabled}
+          autoFocus={focusFallback}
+          autoComplete="organization"
+          value={fallbackText}
+          onChange={(e) => {
+            const text = e.target.value;
+            setFallbackText(text);
+            setValue(text.trim() ? freeTextValue(text) : "");
+          }}
+          className="pl-10"
+        />
+      </div>
+    );
+  }
+
+  const selectedOption: Option | null = selected
+    ? { kind: "selected", value: "__selected__", label: selected.value }
+    : null;
+
+  return (
+    <Select<Option>
+      inputId={id}
+      placeholder={placeholder || t("type_to_search_business")}
+      isDisabled={isDisabled}
+      isClearable
+      isSearchable
+      isLoading={isLoading}
+      value={selectedOption}
+      options={options}
+      inputValue={inputValue}
+      filterOption={() => true}
+      openMenuOnClick={false}
+      openMenuOnFocus={false}
+      blurInputOnSelect
+      menuPlacement="auto"
+      components={{ DropdownIndicator: null, IndicatorSeparator: null }}
+      noOptionsMessage={() =>
+        inputValue.trim().length < MIN_QUERY_LENGTH ? t("type_to_search_business") : t("no_businesses_found")
+      }
+      formatOptionLabel={(option: Option, meta: FormatOptionLabelMeta<Option>) => {
+        if (meta.context === "value") {
+          return <span className="truncate">{option.label}</span>;
+        }
+        if (option.kind === "prediction") {
+          return (
+            <div className="flex min-w-0 flex-col">
+              <span className="text-emphasis truncate">{option.suggestion.mainText}</span>
+              {option.suggestion.secondaryText ? (
+                <span className="text-subtle truncate text-xs">{option.suggestion.secondaryText}</span>
+              ) : null}
+            </div>
+          );
+        }
+        return <span className="text-default italic">{option.label}</span>;
+      }}
+      onInputChange={(newValue: string, meta: InputActionMeta) => {
+        if (meta.action === "input-change") {
+          updateInput(newValue);
+          return;
+        }
+        if (meta.action === "input-blur") {
+          const typed = inputValueRef.current.trim();
+          // Don't lose a typed answer on tab-out, but never overwrite an existing selection.
+          if (typed && !selected) {
+            latestPlaceIdRef.current = null;
+            setValue(freeTextValue(typed));
+          }
+          updateInput("");
+        }
+      }}
+      onChange={(option: SingleValue<Option>) => {
+        if (!option) {
+          latestPlaceIdRef.current = null;
+          setSuggestions([]);
+          updateInput("");
+          sessionTokenRef.current = newPlacesSessionToken();
+          setValue("");
+          return;
+        }
+        if (option.kind === "freeText") {
+          latestPlaceIdRef.current = null;
+          updateInput("");
+          setValue(freeTextValue(option.text));
+          return;
+        }
+        if (option.kind === "prediction") {
+          const { suggestion } = option;
+          latestPlaceIdRef.current = suggestion.placeId;
+          updateInput("");
+          setSuggestions([]);
+          const optimistic = normalizeBusinessPlace({
+            value: buildBusinessPlaceSummary(suggestion.mainText, suggestion.secondaryText),
+            name: suggestion.mainText,
+            address: suggestion.secondaryText,
+            placeId: suggestion.placeId,
+          });
+          if (optimistic) setValue(optimistic);
+          // The details call closes the billing session; start a fresh one for any later search.
+          const sessionToken = sessionTokenRef.current;
+          sessionTokenRef.current = newPlacesSessionToken();
+          fetchDetails(suggestion, sessionToken);
+        }
+      }}
+    />
+  );
+}
+
+export default BusinessPlaceInput;
