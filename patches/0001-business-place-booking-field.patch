--- /dev/null
+++ b/packages/lib/bookings/businessPlace.ts
@@ -0,0 +1,182 @@
+/**
+ * Shared, framework-free helpers for the `businessPlace` booking question type.
+ *
+ * A `businessPlace` response is either `""` (nothing entered) or a flat object of strings.
+ * `value` is always a human readable summary so code that unwraps `.value` keeps working.
+ * Absence of `placeId` means the booker typed the business name themselves.
+ */
+
+export type BusinessPlaceValue = {
+  value: string;
+  name: string;
+  placeId?: string;
+  address?: string;
+  phone?: string;
+  website?: string;
+  mapsUrl?: string;
+  category?: string;
+};
+
+const BUSINESS_PLACE_KEYS = [
+  "value",
+  "name",
+  "placeId",
+  "address",
+  "phone",
+  "website",
+  "mapsUrl",
+  "category",
+] as const;
+
+type BusinessPlaceKey = (typeof BUSINESS_PLACE_KEYS)[number];
+
+const MAX_LENGTHS: Record<BusinessPlaceKey, number> = {
+  value: 500,
+  name: 200,
+  placeId: 512,
+  address: 300,
+  phone: 40,
+  website: 500,
+  mapsUrl: 500,
+  category: 100,
+};
+
+export const BUSINESS_PLACE_ID_REGEX = /^[A-Za-z0-9_-]{8,512}$/;
+
+const SUMMARY_SEPARATOR = " — ";
+
+export const isBusinessPlaceValue = (v: unknown): v is BusinessPlaceValue => {
+  if (typeof v !== "object" || v === null || Array.isArray(v)) return false;
+  const obj = v as Record<string, unknown>;
+  // `{ value, optionValue }` is the radioInput/location shape, never ours.
+  if ("optionValue" in obj) return false;
+  if (typeof obj.name !== "string" || typeof obj.value !== "string") return false;
+  return BUSINESS_PLACE_KEYS.every((key) => obj[key] === undefined || typeof obj[key] === "string");
+};
+
+export function buildBusinessPlaceSummary(name: string, address?: string): string {
+  const trimmedName = name.trim();
+  const trimmedAddress = address?.trim();
+  return trimmedAddress ? `${trimmedName}${SUMMARY_SEPARATOR}${trimmedAddress}` : trimmedName;
+}
+
+function parseHttpUrl(raw: string): URL | null {
+  try {
+    const url = new URL(raw);
+    return url.protocol === "https:" || url.protocol === "http:" ? url : null;
+  } catch {
+    return null;
+  }
+}
+
+function normalizeWebsite(raw: string): string | undefined {
+  if (/\s/.test(raw)) return undefined;
+  if (/^https?:\/\//i.test(raw)) {
+    return parseHttpUrl(raw) ? raw : undefined;
+  }
+  // Any other scheme (javascript:, data:, mailto:, ...) is dropped.
+  if (/^[a-z][a-z0-9+.-]*:/i.test(raw)) return undefined;
+  // Bare domains are prefixed, mirroring the `url` field type.
+  if (/^[a-z0-9.-]+\.[a-z]{2,}(\/\S*)?$/i.test(raw)) {
+    const withProtocol = `https://${raw}`;
+    return parseHttpUrl(withProtocol) ? withProtocol : undefined;
+  }
+  return undefined;
+}
+
+function normalizeMapsUrl(raw: string): string | undefined {
+  const url = parseHttpUrl(raw);
+  if (!url || url.protocol !== "https:") return undefined;
+  // Only Google hosts (google.com, google.ca, google.co.uk, google.com.au, ...), so a booker can't plant
+  // arbitrary links that later render as anchors. `google.evil.com` must not pass.
+  return /(^|\.)google\.(com|[a-z]{2}|co\.[a-z]{2}|com\.[a-z]{2})$/i.test(url.hostname) ? raw : undefined;
+}
+
+/**
+ * Turns anything a client or the DB hands us into a safe `BusinessPlaceValue`, or `""` when there
+ * is no usable business name.
+ */
+export function normalizeBusinessPlace(input: unknown): BusinessPlaceValue | "" {
+  if (typeof input !== "object" || input === null || Array.isArray(input)) return "";
+  const raw = input as Record<string, unknown>;
+  const out: Partial<Record<BusinessPlaceKey, string>> = {};
+
+  for (const key of BUSINESS_PLACE_KEYS) {
+    const value = raw[key];
+    if (typeof value !== "string") continue;
+    const trimmed = value.trim();
+    if (!trimmed) continue;
+
+    if (key === "website") {
+      const website = trimmed.length <= MAX_LENGTHS.website ? normalizeWebsite(trimmed) : undefined;
+      if (website) out.website = website;
+    } else if (key === "mapsUrl") {
+      const mapsUrl = trimmed.length <= MAX_LENGTHS.mapsUrl ? normalizeMapsUrl(trimmed) : undefined;
+      if (mapsUrl) out.mapsUrl = mapsUrl;
+    } else if (key === "placeId") {
+      // Validated (not truncated) by the schema; a truncated id would point at the wrong place.
+      out.placeId = trimmed;
+    } else if (key === "phone") {
+      if (trimmed.length <= MAX_LENGTHS.phone) out.phone = trimmed;
+    } else {
+      out[key] = trimmed.slice(0, MAX_LENGTHS[key]);
+    }
+  }
+
+  const name = (out.name || out.value || "").slice(0, MAX_LENGTHS.name).trim();
+  if (!name) return "";
+
+  const result: BusinessPlaceValue = {
+    value: (out.value || buildBusinessPlaceSummary(name, out.address)).slice(0, MAX_LENGTHS.value),
+    name,
+  };
+  if (out.placeId) result.placeId = out.placeId;
+  if (out.address) result.address = out.address;
+  if (out.phone) result.phone = out.phone;
+  if (out.website) result.website = out.website;
+  if (out.mapsUrl) result.mapsUrl = out.mapsUrl;
+  if (out.category) result.category = out.category;
+  return result;
+}
+
+export type BusinessPlaceLine = {
+  kind: "name" | "address" | "category" | "phone" | "website" | "maps";
+  text: string;
+  href?: string;
+};
+
+function displayWebsite(website: string): string {
+  return website.replace(/^https?:\/\//i, "").replace(/\/$/, "");
+}
+
+/**
+ * Structured lines for rendering. Hrefs come from a re-normalised copy, so only http(s) websites,
+ * Google Maps links and `tel:` numbers can ever become anchors.
+ */
+export function getBusinessPlaceLines(input: BusinessPlaceValue): BusinessPlaceLine[] {
+  const v = normalizeBusinessPlace(input);
+  if (!v) return [];
+  const lines: BusinessPlaceLine[] = [{ kind: "name", text: v.name }];
+  if (v.address) lines.push({ kind: "address", text: v.address });
+  if (v.category) lines.push({ kind: "category", text: v.category });
+  if (v.phone) {
+    const dialable = v.phone.replace(/[^\d+]/g, "");
+    lines.push({ kind: "phone", text: v.phone, ...(dialable ? { href: `tel:${dialable}` } : {}) });
+  }
+  if (v.website) lines.push({ kind: "website", text: displayWebsite(v.website), href: v.website });
+  if (v.mapsUrl) lines.push({ kind: "maps", text: "Google Maps", href: v.mapsUrl });
+  return lines;
+}
+
+/**
+ * Plain-text rendering. Single line (workflow variables, AI phone calls) keeps it short;
+ * multiline (emails, calendar descriptions) includes the category and links.
+ */
+export function formatBusinessPlaceText(input: BusinessPlaceValue, opts?: { multiline?: boolean }): string {
+  const v = normalizeBusinessPlace(input);
+  if (!v) return "";
+  if (!opts?.multiline) {
+    return [v.name, v.address, v.phone, v.website].filter(Boolean).join(", ");
+  }
+  return [v.name, v.address, v.category, v.phone, v.website, v.mapsUrl].filter(Boolean).join("\n");
+}
