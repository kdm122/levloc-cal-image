@@ -0,0 +1,196 @@
+import { BUSINESS_PLACE_ID_REGEX } from "@calcom/lib/bookings/businessPlace";
+import { HttpError } from "@calcom/lib/http-error";
+import logger from "@calcom/lib/logger";
+
+const log = logger.getSubLogger({ prefix: ["GooglePlaces"] });
+
+const PLACES_BASE_URL = "https://places.googleapis.com/v1";
+const UPSTREAM_TIMEOUT_MS = 4000;
+const MAX_SUGGESTIONS = 8;
+const DEFAULT_REGION_CODES = ["us", "ca"];
+const DETAILS_FIELD_MASK = [
+  "id",
+  "displayName",
+  "formattedAddress",
+  "nationalPhoneNumber",
+  "internationalPhoneNumber",
+  "websiteUri",
+  "googleMapsUri",
+  "primaryTypeDisplayName",
+].join(",");
+
+export type PlaceSuggestion = { placeId: string; mainText: string; secondaryText: string };
+
+export type PlaceDetails = {
+  placeId: string;
+  name: string;
+  address?: string;
+  phone?: string;
+  website?: string;
+  mapsUrl?: string;
+  category?: string;
+};
+
+export function isPlacesEnabled(): boolean {
+  return !!process.env.GOOGLE_PLACES_API_KEY;
+}
+
+export function getRegionCodes(): string[] {
+  const raw = process.env.GOOGLE_PLACES_REGION_CODES;
+  if (!raw) return DEFAULT_REGION_CODES;
+  const codes = raw
+    .split(",")
+    .map((code) => code.trim().toLowerCase())
+    .filter((code) => /^[a-z]{2}$/.test(code));
+  // Places API (New) accepts at most 15 region codes
+  return codes.length ? codes.slice(0, 15) : DEFAULT_REGION_CODES;
+}
+
+function getApiKey(): string {
+  const key = process.env.GOOGLE_PLACES_API_KEY;
+  if (!key) throw new HttpError({ statusCode: 503, message: "places_disabled" });
+  return key;
+}
+
+const asString = (value: unknown): string => (typeof value === "string" ? value.trim() : "");
+
+async function callPlaces(url: string, init: RequestInit, operation: string): Promise<unknown> {
+  let res: Response;
+  try {
+    const signal =
+      typeof AbortSignal !== "undefined" && typeof AbortSignal.timeout === "function"
+        ? AbortSignal.timeout(UPSTREAM_TIMEOUT_MS)
+        : undefined;
+    res = await fetch(url, { ...init, cache: "no-store", signal });
+  } catch (error) {
+    log.error(`${operation} request failed`, error instanceof Error ? error.message : String(error));
+    throw new HttpError({ statusCode: 502, message: "places_upstream_error" });
+  }
+
+  if (!res.ok) {
+    // Log Google's error status for debugging, but never forward its body to the browser.
+    let reason = "";
+    try {
+      const body = (await res.json()) as { error?: { status?: string } };
+      reason = asString(body?.error?.status);
+    } catch {
+      // ignore unparsable bodies
+    }
+    log.error(`${operation} returned HTTP ${res.status}`, reason);
+    throw new HttpError({ statusCode: 502, message: "places_upstream_error" });
+  }
+
+  return res.json();
+}
+
+type RawPrediction = {
+  placeId?: unknown;
+  types?: unknown;
+  text?: { text?: unknown };
+  structuredFormat?: { mainText?: { text?: unknown }; secondaryText?: { text?: unknown } };
+};
+
+export function mapAutocompleteResponse(data: unknown): PlaceSuggestion[] {
+  const suggestions = (data as { suggestions?: unknown })?.suggestions;
+  if (!Array.isArray(suggestions)) return [];
+
+  const result: PlaceSuggestion[] = [];
+  for (const suggestion of suggestions) {
+    const prediction = (suggestion as { placePrediction?: RawPrediction })?.placePrediction;
+    if (!prediction) continue;
+    const placeId = asString(prediction.placeId);
+    if (!BUSINESS_PLACE_ID_REGEX.test(placeId)) continue;
+    // Businesses only: drop streets, cities, postal codes, etc.
+    const types = Array.isArray(prediction.types) ? prediction.types : [];
+    if (!types.includes("establishment")) continue;
+    const mainText = asString(prediction.structuredFormat?.mainText?.text) || asString(prediction.text?.text);
+    if (!mainText) continue;
+    result.push({
+      placeId,
+      mainText,
+      secondaryText: asString(prediction.structuredFormat?.secondaryText?.text),
+    });
+    if (result.length >= MAX_SUGGESTIONS) break;
+  }
+  return result;
+}
+
+export async function autocompletePlaces({
+  input,
+  sessionToken,
+  languageCode,
+}: {
+  input: string;
+  sessionToken?: string;
+  languageCode?: string;
+}): Promise<PlaceSuggestion[]> {
+  const body: Record<string, unknown> = { input, includedRegionCodes: getRegionCodes() };
+  if (sessionToken) body.sessionToken = sessionToken;
+  if (languageCode) body.languageCode = languageCode;
+
+  const data = await callPlaces(
+    `${PLACES_BASE_URL}/places:autocomplete`,
+    {
+      method: "POST",
+      headers: { "Content-Type": "application/json", "X-Goog-Api-Key": getApiKey() },
+      body: JSON.stringify(body),
+    },
+    "autocomplete"
+  );
+  return mapAutocompleteResponse(data);
+}
+
+type RawPlace = {
+  displayName?: { text?: unknown };
+  formattedAddress?: unknown;
+  nationalPhoneNumber?: unknown;
+  internationalPhoneNumber?: unknown;
+  websiteUri?: unknown;
+  googleMapsUri?: unknown;
+  primaryTypeDisplayName?: { text?: unknown };
+};
+
+export function mapDetailsResponse(data: unknown, placeId: string): PlaceDetails | null {
+  const place = data as RawPlace | null;
+  const name = asString(place?.displayName?.text);
+  if (!place || !name) return null;
+
+  const details: PlaceDetails = { placeId, name };
+  const address = asString(place.formattedAddress);
+  if (address) details.address = address;
+  // International format keeps the country code, so `tel:` links and the CRM get a dialable number.
+  const phone = asString(place.internationalPhoneNumber) || asString(place.nationalPhoneNumber);
+  if (phone) details.phone = phone;
+  const website = asString(place.websiteUri);
+  if (website) details.website = website;
+  const mapsUrl = asString(place.googleMapsUri);
+  if (mapsUrl) details.mapsUrl = mapsUrl;
+  const category = asString(place.primaryTypeDisplayName?.text);
+  if (category) details.category = category;
+  return details;
+}
+
+export async function getPlaceDetails({
+  placeId,
+  sessionToken,
+  languageCode,
+}: {
+  placeId: string;
+  sessionToken?: string;
+  languageCode?: string;
+}): Promise<PlaceDetails | null> {
+  const params = new URLSearchParams();
+  if (sessionToken) params.set("sessionToken", sessionToken);
+  if (languageCode) params.set("languageCode", languageCode);
+  const query = params.toString();
+
+  const data = await callPlaces(
+    `${PLACES_BASE_URL}/places/${encodeURIComponent(placeId)}${query ? `?${query}` : ""}`,
+    {
+      method: "GET",
+      headers: { "X-Goog-Api-Key": getApiKey(), "X-Goog-FieldMask": DETAILS_FIELD_MASK },
+    },
+    "details"
+  );
+  return mapDetailsResponse(data, placeId);
+}
