+import type { Params } from "app/_types";
+import { defaultResponderForAppDir } from "app/api/defaultResponderForAppDir";
+import type { NextRequest } from "next/server";
+import { NextResponse } from "next/server";
+
+import getIP from "@calcom/lib/getIP";
+import { piiHasher } from "@calcom/lib/server/PiiHasher";
+import { handleDetailsRequest } from "@calcom/lib/server/places/handlers";
+
+// Server-side proxy so GOOGLE_PLACES_API_KEY never reaches the browser.
+export const dynamic = "force-dynamic";
+
+async function handler(req: NextRequest, { params }: { params: Promise<Params> }) {
+  const { placeId } = await params;
+  const result = await handleDetailsRequest({
+    placeId,
+    searchParams: req.nextUrl.searchParams,
+    clientKey: piiHasher.hash(getIP(req)),
+  });
+  return NextResponse.json(result.body, { status: result.status, headers: result.headers });
+}
+
+export const GET = defaultResponderForAppDir(handler);
