+import { type BusinessPlaceValue, getBusinessPlaceLines } from "@calcom/lib/bookings/businessPlace";
+import classNames from "@calcom/ui/classNames";
+
+/**
+ * Renders a `businessPlace` booking response. Hrefs come from `getBusinessPlaceLines`, which only
+ * yields http(s) websites, Google Maps links and `tel:` numbers.
+ */
+export function BusinessPlaceAnswer({ value, className }: { value: BusinessPlaceValue; className?: string }) {
+  const lines = getBusinessPlaceLines(value);
+  if (!lines.length) return null;
+
+  return (
+    <div className={classNames("flex flex-col gap-0.5", className)} data-testid="business-place-answer">
+      {lines.map((line) => {
+        if (line.kind === "name") {
+          return (
+            <span key={line.kind} className="font-medium">
+              {line.text}
+            </span>
+          );
+        }
+        if (line.href) {
+          const isExternal = line.kind === "website" || line.kind === "maps";
+          return (
+            <a
+              key={line.kind}
+              href={line.href}
+              className="w-fit underline"
+              {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}>
+              {line.text}
+            </a>
+          );
+        }
+        return (
+          <span key={line.kind} className={line.kind === "category" ? "text-subtle" : undefined}>
+            {line.text}
+          </span>
+        );
+      })}
+    </div>
+  );
+}
+
+export default BusinessPlaceAnswer;
