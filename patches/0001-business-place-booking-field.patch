@@ -0,0 +1,43 @@
+/**
+ * Per-process token bucket. Used because the Unkey limiter is a no-op without UNKEY_ROOT_KEY.
+ * Deliberately in-memory: this deployment runs a single replica.
+ */
+type Bucket = { tokens: number; updatedAt: number };
+
+const MAX_TRACKED_KEYS = 5000;
+
+const buckets = new Map<string, Bucket>();
+
+export type ConsumeResult = { ok: boolean; retryAfterSec: number };
+
+export function consumeToken(
+  key: string,
+  { capacity, refillPerSec }: { capacity: number; refillPerSec: number },
+  now: number = Date.now()
+): ConsumeResult {
+  if (buckets.size > MAX_TRACKED_KEYS) prune(now, capacity, refillPerSec);
+
+  const existing = buckets.get(key);
+  const elapsedSec = existing ? Math.max(0, now - existing.updatedAt) / 1000 : 0;
+  const tokens = existing ? Math.min(capacity, existing.tokens + elapsedSec * refillPerSec) : capacity;
+
+  if (tokens >= 1) {
+    buckets.set(key, { tokens: tokens - 1, updatedAt: now });
+    return { ok: true, retryAfterSec: 0 };
+  }
+
+  buckets.set(key, { tokens, updatedAt: now });
+  return { ok: false, retryAfterSec: Math.max(1, Math.ceil((1 - tokens) / refillPerSec)) };
+}
+
+// Drop buckets that would be full again by now; they carry no state worth keeping.
+function prune(now: number, capacity: number, refillPerSec: number) {
+  for (const [key, bucket] of buckets) {
+    const refilled = bucket.tokens + (Math.max(0, now - bucket.updatedAt) / 1000) * refillPerSec;
+    if (refilled >= capacity) buckets.delete(key);
+  }
+}
+
+export function resetRateLimiterForTests() {
+  buckets.clear();
+}
